<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ZombicideCompanion.Views.SpawnCards.SpawnCardDrawerPage"
             Title="Spawn Card Drawer">
	<!--<VerticalStackLayout>-->
		<Grid>
			<Grid.RowDefinitions>
				<RowDefinition Height="*"/>
				<RowDefinition Height="Auto"/>
			</Grid.RowDefinitions>
			<VerticalStackLayout Grid.Row="0">
				<Grid>
					<Grid.ColumnDefinitions>
						<ColumnDefinition Width="*"/>
						<ColumnDefinition Width="Auto" />
					</Grid.ColumnDefinitions>
					<Label Grid.Column="0" x:Name="SpawnCardsInDeckLabel" FontSize="18" VerticalTextAlignment="Center"/>
					<Button Grid.Column="1" FontSize="18" Text="Mischen" Clicked="ShuffleSpawnCardsButton_Clicked" HorizontalOptions="End"/>
				</Grid>
				<Grid>
					<Grid.ColumnDefinitions>
						<ColumnDefinition Width="*" />
						<ColumnDefinition Width="64" />
						<ColumnDefinition Width="128" />
						<ColumnDefinition Width="64" />
					</Grid.ColumnDefinitions>
					<Label Grid.Column="0" Text="Gefahrenstufe:" FontSize="18" VerticalTextAlignment="Center"/>
					<Button Grid.Column="1" 
					Text="-" 
					Clicked="DangerLevelDecreaseButton_Clicked"
					FontSize="24"/>
					<Label Grid.Column="2" FontSize="36" x:Name="DangerLevelLabel" HorizontalTextAlignment="Center" VerticalTextAlignment="Center"></Label>
					<Button Grid.Column="3" 
					Text="+" 
					Clicked="DangerLevelIncreaseButton_Clicked"
					FontSize="24"/>
				</Grid>
				<VerticalStackLayout x:Name="SpawnCardTextVerticalLayout">
				</VerticalStackLayout>
			</VerticalStackLayout>
			<Button Grid.Row="1" FontSize="36" Text="Karte ziehen" Clicked="DrawSpawnCardButton_Clicked" VerticalOptions="End"/>
		</Grid>
	<!--</VerticalStackLayout>-->
</ContentPage>