             x:Class="ZombicideCompanion.Views.SpawnCards.SpawnCardsConfigPage"
             Title="Spawn cards config">
	<Grid RowSpacing="4">
		<Grid.RowDefinitions>
			<RowDefinition Height="*" />
		</Grid.RowDefinitions>

		<ListView Grid.Row="0" x:Name="SpawnCardsListView" SelectionMode="None">
			<ListView.ItemTemplate>
				<DataTemplate>
					<ViewCell>
						<Grid Padding="10">
							<Grid.ColumnDefinitions>
								<ColumnDefinition Width="*" />
								<ColumnDefinition Width="36" />
							</Grid.ColumnDefinitions>
							<Grid.RowDefinitions>
								<RowDefinition Height="*" />
								<RowDefinition Height="*" />
							</Grid.RowDefinitions>
							<Label Grid.Column="0" Grid.Row="0" x:Name="CardNumberLabel" Text="{Binding CardNumber}"/>
							<Label Grid.Column="0" Grid.Row="1" x:Name="CardTitleLabel" Text="{Binding Title}"/>

							<!--<Grid Padding="10" Grid.Column="0" Grid.Row="0">
								<Grid.ColumnDefinitions>
									<ColumnDefinition Width="*" />
									<ColumnDefinition Width="*" />
								</Grid.ColumnDefinitions>
								<Label Grid.Column="0" x:Name="CardNumberLabel" Text="{Binding CardNumber}" FontSize="18"/>
								<Label Grid.Column="1" x:Name="CardTitleLabel" Text="{Binding Title}" FontSize="18"/>
							</Grid>
							<Grid Padding="10" Grid.Column="0" Grid.Row="1">
								<Grid.ColumnDefinitions>
									<ColumnDefinition Width="*" />
									<ColumnDefinition Width="*" />
								</Grid.ColumnDefinitions>
								<Label Grid.Column="0" x:Name="CardTypeLabel" Text="{Binding TypeText}" FontSize="18"/>
								<Label Grid.Column="1" x:Name="CardTextLabel" Text="{Binding Text}" MaxLines="1" FontSize="18"/>
							</Grid>-->
						</Grid>
					</ViewCell>
				</DataTemplate>
			</ListView.ItemTemplate>
		</ListView>
	</Grid>
</ContentPage>