						</DataTemplate>
					</ListView.ItemTemplate>
				</ListView>-->
			</Grid>
			<VerticalStackLayout x:Name="SpawnCardsVerticalStackLayout">
				
			</VerticalStackLayout>
		</VerticalStackLayout>
	</ScrollView>
</ContentPage>