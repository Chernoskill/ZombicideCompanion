<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
			 xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             x:Class="ZombicideCompanion.Views.SpawnCards.SpawnCardsConfigPage"
             Title="Spawn cards config"
			 xmlns:local="clr-namespace:ZombicideCompanion.Views.SpawnCards">
	<Grid>
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="*"/>
		</Grid.RowDefinitions>
		<Border StrokeThickness="1.5" Padding="6,6,6,6" Margin="6,6,6,6">
			<Grid RowSpacing="4">
				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="*"/>
					<ColumnDefinition Width="80"/>
					<ColumnDefinition Width="92"/>
				</Grid.ColumnDefinitions>
				<Grid.RowDefinitions>
					<RowDefinition Height="Auto" />
					<RowDefinition Height="Auto" />
					<RowDefinition Height="Auto" />
					<RowDefinition Height="Auto" />
					<RowDefinition Height="Auto" />
				</Grid.RowDefinitions>
				<Label Grid.Row="0" Grid.Column="0" Text="Karten insgesamt" FontSize="16" FontAttributes="Bold"/>
				<Label Grid.Row="0" Grid.Column="1" x:Name="SpawnCardsCountLabel" FontSize="16" FontAttributes="Bold" HorizontalTextAlignment="Center"/>
				<Label Grid.Row="0" Grid.Column="2" Text="100%" HorizontalTextAlignment="Start" FontSize="16" FontAttributes="Bold"/>

				<Label Grid.Row="1" Grid.Column="0" Text="Xeno-Brut" FontSize="16" />
				<Label Grid.Row="1" Grid.Column="1" x:Name="SpawnCardsCountNormalLabel" FontSize="16" HorizontalTextAlignment="Center"/>
				<Label Grid.Row="1" Grid.Column="2" x:Name="SpawnCardsRatioNormalLabel" FontSize="16" HorizontalTextAlignment="Start">
					<Label.FormattedText>
						<FormattedString>
							<Span x:Name="SpawnCardsRatioNormalLabelMain"/>
							<Span Text="%"/>
						</FormattedString>
					</Label.FormattedText>
				</Label>
				<Label Grid.Row="2" Grid.Column="0" Text="Fäulnis" FontSize="16"/>
				<Label Grid.Row="2" Grid.Column="1" x:Name="SpawnCardsCountMoldLabel" FontSize="16" HorizontalTextAlignment="Center"/>
				<Label Grid.Row="2" Grid.Column="2" x:Name="SpawnCardsRatioMoldLabel" FontSize="16" HorizontalTextAlignment="Start">
					<Label.FormattedText>
						<FormattedString>
							<Span x:Name="SpawnCardsRatioMoldLabelMain"/>
							<Span Text="%"/>
						</FormattedString>
					</Label.FormattedText>
				</Label>
				<Label Grid.Row="3" Grid.Column="0" Text="Monstrum" FontSize="16"/>
				<Label Grid.Row="3" Grid.Column="1" x:Name="SpawnCardsCountAbominationLabel" FontSize="16" HorizontalTextAlignment="Center"/>
				<Label Grid.Row="3" Grid.Column="2" x:Name="SpawnCardsRatioAbominationLabel" FontSize="16" HorizontalTextAlignment="Start">
					<Label.FormattedText>
						<FormattedString>
							<Span x:Name="SpawnCardsRatioAbominationLabelMain"/>
							<Span Text="%"/>
							<Span x:Name="SpawnCardsRatioAbominationLabelDeviation"/>
						</FormattedString>
					</Label.FormattedText>
				</Label>
				<Label Grid.Row="4" Grid.Column="0" Text="Extra-Aktivierung" FontSize="16"/>
				<Label Grid.Row="4" Grid.Column="1" x:Name="SpawnCardsCountExtraActivationLabel" FontSize="16" HorizontalTextAlignment="Center"/>
				<Label Grid.Row="4" Grid.Column="2" x:Name="SpawnCardsRatioExtraActivationLabel" FontSize="16" HorizontalTextAlignment="Start">
					<Label.FormattedText>
						<FormattedString>
							<Span x:Name="SpawnCardsRatioExtraActivationLabelMain"/>
							<Span Text="%"/>
						</FormattedString>
					</Label.FormattedText>
				</Label>
			</Grid>
		</Border>
		<ScrollView Grid.Row="1">
			<VerticalStackLayout x:Name="SpawnCardsVerticalStackLayout" Margin="6,6,6,6" Spacing="0">
			</VerticalStackLayout>
		</ScrollView>
	</Grid>
</ContentPage>