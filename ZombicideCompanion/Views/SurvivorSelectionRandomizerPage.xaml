<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ZombicideCompanion.Views.SurvivorSelectionRandomizerPage"
             Title="Survivor Selection Randomizer">
	<Grid RowSpacing="4">
		<Grid.RowDefinitions>
			<RowDefinition Height="64" />
			<RowDefinition Height="64" />
			<RowDefinition Height="*" />
			<RowDefinition Height="*" />
		</Grid.RowDefinitions>
		<Grid.ColumnDefinitions>
			<ColumnDefinition Width="*" />
		</Grid.ColumnDefinitions>

		<Button Grid.Row="0"
			Text="Load from file"
			Clicked="PickSurvivorFileButton_Clicked" 
			FontSize="36"/>

		<Button Grid.Row="1" 
			Text="Randomize Team!" 
			Clicked="RandomizeTeam_Clicked" 
			FontSize="36"/>
			
		<ListView Grid.Row="2" x:Name="randomTeamListView" SelectionMode="None">
			<ListView.ItemTemplate>
				<DataTemplate>
					<ViewCell>
						<Grid Padding="10">
							<Grid.ColumnDefinitions>
								<ColumnDefinition Width="64" />
								<ColumnDefinition Width="*" />
							</Grid.ColumnDefinitions>
							<Image Grid.Column="0"
							   Source="{Binding ClassTypeImageName}"
							   Aspect="AspectFill"
							   HeightRequest="64"
							   WidthRequest="64" />
							<Label Grid.Column="1" Text="{Binding Name}" FontSize="18" VerticalTextAlignment="Center"/>
						</Grid>
					</ViewCell>
				</DataTemplate>
			</ListView.ItemTemplate>
		</ListView>

		<ListView Grid.Row="3" x:Name="survivorsListView" SelectionMode="None">
			<ListView.ItemTemplate>
				<DataTemplate>
					<ViewCell>
						<Grid Padding="10">
							<Label Text="{Binding Name}" FontSize="18" VerticalTextAlignment="Center"/>
						</Grid>
					</ViewCell>
				</DataTemplate>
			</ListView.ItemTemplate>
		</ListView>
	</Grid>
</ContentPage>