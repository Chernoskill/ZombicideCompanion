<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ZombicideCompanion.Views.SurvivorSelectionRandomizerPage"
             Title="Survivor Selection Randomizer">
	<Grid RowSpacing="4">
		<Grid.RowDefinitions>
			<RowDefinition Height="64" />
			<RowDefinition Height="64" />
			<RowDefinition Height="64" />
			<RowDefinition Height="*" />
		</Grid.RowDefinitions>
		<Grid.ColumnDefinitions>
			<ColumnDefinition Width="*" />
		</Grid.ColumnDefinitions>
		<Button Grid.Row="0"
			Text="Main Page"
			Clicked="MainPageButton_Clicked">
		</Button>
		<Button Grid.Row="1"
			Text="Load from file"
			Clicked="PickSurvivorFileButton_Clicked">
		</Button>
		<Label Grid.Row="2" x:Name="randomTeamLabel" FontSize="18"/>
		<Button Text="Randomize Team!" Clicked="SelectRandomTeam_Clicked" FontSize="18"/>

		<ListView Grid.Row="3" x:Name="survivorsListView" SelectionMode="None">
			<ListView.ItemTemplate>
				<DataTemplate>
					<ViewCell>
						<Grid Padding="10">
							<Label Text="{Binding Name}" FontSize="18" VerticalTextAlignment="Center"/>
						</Grid>
					</ViewCell>
				</DataTemplate>
			</ListView.ItemTemplate>
		</ListView>
	</Grid>
</ContentPage>